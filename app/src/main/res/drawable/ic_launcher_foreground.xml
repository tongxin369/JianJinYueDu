<?xml version="1.0" encoding="utf-8"?>
<!--
  「渐进阅读 JianJinYueDu」Logo
  设计理念：翻开的书 = 阅读；自书页向上升起的箭头 = 循序渐进、由易到难。
  元素少、对比强，缩到 48dp 依然一眼可辨。
  图形整体控制在中心 48×48 的安全区内（18~90），任何图标遮罩形状都不会裁切。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 翻开的书页：左页 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,58.4 C46,54.7 37.5,53.8 30,54.7 L30,74.3 C37.5,73.3 46,74.3 54,78 Z" />

    <!-- 翻开的书页：右页 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,58.4 C62,54.7 70.5,53.8 78,54.7 L78,74.3 C70.5,73.3 62,74.3 54,78 Z" />

    <!-- 书脊：一条与背景同色的中缝，让「打开的书」更易识别 -->
    <path
        android:fillColor="#0E7C56"
        android:pathData="M53.1,58.8 L54.9,58.8 L54.9,77.8 L53.1,77.8 Z" />

    <!-- 上升箭头：由书页升出，表达「循序渐进」 -->
    <path
        android:strokeColor="#A9F0C8"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,51.9 L54,30.5 M45.5,39.3 L54,30 L62.5,39.3" />
</vector>
